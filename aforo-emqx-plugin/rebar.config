%% -*- mode: erlang -*-
%% rebar3 build manifest for the aforo_metering EMQX plugin.
%%
%% Layout follows the official EMQX 5.x plugin template
%% (github.com/emqx/emqx-plugin-template, emqx_plugin_helper v5.9.1,
%% emqx_plugrel 0.6.3):
%%
%%   rebar3 compile              compile (no EMQX source tree needed: the
%%                               EMQX headers come from emqx_plugin_helper)
%%   rebar3 emqx_plugrel tar     build the installable plugin package
%%     -> _build/default/emqx_plugrel/aforo_metering-2.0.1.tar.gz
%%        (contains release.json, README.md and the rel_apps below)
%%
%% emqx_plugrel validates priv/config.hocon against priv/config_schema.avsc
%% while building; a default that does not match the schema fails the build.

{erl_opts, [debug_info]}.

{deps, [
    {jsone, "1.8.1"},
    {emqx_plugin_helper,
        {git, "https://github.com/emqx/emqx-plugin-helper.git", {tag, "v5.9.1"}}}
]}.

{plugins, [
    {emqx_plugrel, {git, "https://github.com/emqx/emqx_plugrel.git", {tag, "0.6.3"}}}
]}.

%% The plugin release. Name + version form the plugin's identity in EMQX
%% (`aforo_metering-2.0.1'); keep the version equal to the `vsn' in
%% src/aforo_metering.app.src (aforo_metering_version_tests checks this).
%% emqx_plugrel packs exactly the applications listed here, so every
%% non-OTP runtime dependency (jsone) must be listed.
{relx, [
    {release, {aforo_metering, "2.0.1"}, [
        aforo_metering,
        emqx_plugin_helper,
        jsone
    ]},
    {dev_mode, false},
    {include_erts, false},
    {include_src, false}
]}.

%% Written into release.json by emqx_plugrel.
{emqx_plugrel, [
    {authors, ["Aforo"]},
    {builder, [
        {name, "Aforo"},
        {contact, "support@aforo.ai"},
        {website, "https://aforo.ai"}
    ]},
    {repo, "https://github.com/aforoai/SDKs"},
    {functionality, ["Metering"]},
    %% client_attrs (the default customer source) needs EMQX 5.7.0+.
    {compatibility, [{emqx, "~> 5.7"}]},
    {description, "Meters MQTT connect/publish/deliver/subscribe traffic per customer and sends per-minute usage to Aforo."}
]}.

{profiles, [
    {test, [
        %% AFORO_NO_EMQX: counters live in a local ETS table instead of
        %% emqx_metrics (aforo_metering_metrics), so the suites can assert
        %% on them without an EMQX node.
        {erl_opts, [debug_info, {d, 'TEST'}, {d, 'AFORO_NO_EMQX'}]},
        {deps, [{proper, "1.4.0"}]}
    ]}
]}.
