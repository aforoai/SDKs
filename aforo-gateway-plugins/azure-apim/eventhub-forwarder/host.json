{
  "version": "2.0",
  "functionTimeout": "00:10:00",
  "logging": {
    "logLevel": { "default": "Information" }
  },
  "extensions": {
    "eventHubs": {
      "maxEventBatchSize": 500,
      "minEventBatchSize": 1,
      "maxWaitTime": "00:00:05",
      "batchCheckpointFrequency": 1,
      "prefetchCount": 1000,
      "initialOffsetOptions": { "type": "fromStart" }
    }
  },
  "extensionBundle": {
    "id": "Microsoft.Azure.Functions.ExtensionBundle",
    "version": "[4.*, 5.0.0)"
  }
}
