{
  "script": "delivery",
  "base": {
    "vars": {
      "aforoPendingText": "{\"events\": [{\"metricName\": \"api_calls\", \"idempotencyKey\": \"k1\", \"quantity\": 1}, {\"metricName\": \"mcp_server.tool_invocations\", \"idempotencyKey\": \"k2\", \"quantity\": 1}, {\"metricName\": \"tokens\", \"idempotencyKey\": \"k3\", \"quantity\": 5}]}",
      "aforoIngestResponse": null,
      "aforoAttempt": 1,
      "aforoJitter": 0.5,
      "aforoNowMs": 1761609600000
    }
  },
  "cases": [
    {
      "name": "202 with no errors: delivered",
      "expect": {
        "status": 202,
        "retryText": null,
        "refusedLog": null
      },
      "vars": {
        "aforoIngestResponse": {
          "status": 202,
          "text": "{\"success\": true, \"data\": {\"accepted\": 3, \"failed\": 0, \"errors\": []}}"
        }
      }
    },
    {
      "name": "\"could not be stored\" is transient: only that event is re-sent",
      "expect": {
        "retryText.#json": {
          "events": [
            {
              "metricName": "mcp_server.tool_invocations",
              "idempotencyKey": "k2",
              "quantity": 1
            }
          ]
        },
        "retryReason": "1 event(s) could not be stored",
        "refusedLog": null
      },
      "vars": {
        "aforoIngestResponse": {
          "status": 202,
          "text": "{\"success\": true, \"data\": {\"accepted\": 2, \"failed\": 1, \"errors\": [{\"index\": 1, \"message\": \"The event could not be stored. Retry later.\"}]}}"
        }
      }
    },
    {
      "name": "any other per-event error is permanent: logged, not re-sent",
      "expect": {
        "retryText": null,
        "refusedLog": "[aforo-metering] USAGE EVENT REFUSED (permanent, not retried): tokens k3: Unknown metric: tokens"
      },
      "vars": {
        "aforoIngestResponse": {
          "status": 202,
          "text": "{\"success\": true, \"data\": {\"accepted\": 2, \"failed\": 1, \"errors\": [{\"index\": 2, \"message\": \"Unknown metric: tokens\"}]}}"
        }
      }
    },
    {
      "name": "mixed: transient re-sent, permanent logged",
      "expect": {
        "retryText.#json": {
          "events": [
            {
              "metricName": "api_calls",
              "idempotencyKey": "k1",
              "quantity": 1
            }
          ]
        },
        "refusedLog": "[aforo-metering] USAGE EVENT REFUSED (permanent, not retried): mcp_server.tool_invocations k2: productType MCP_SERVER requires agentId"
      },
      "vars": {
        "aforoIngestResponse": {
          "status": 202,
          "text": "{\"success\": true, \"data\": {\"accepted\": 1, \"failed\": 2, \"errors\": [{\"index\": 0, \"message\": \"The event could not be stored\"}, {\"index\": 1, \"message\": \"productType MCP_SERVER requires agentId\"}, {\"message\": \"no index: ignored\"}, {\"index\": 9, \"message\": \"The event could not be stored\"}]}}"
        }
      }
    },
    {
      "name": "the unwrapped {errors} shape is read too",
      "expect": {
        "retryText.#json": {
          "events": [
            {
              "metricName": "tokens",
              "idempotencyKey": "k3",
              "quantity": 5
            }
          ]
        }
      },
      "vars": {
        "aforoIngestResponse": {
          "status": 200,
          "text": "{\"errors\": [{\"index\": 2, \"message\": \"The event could not be stored\"}]}"
        }
      }
    },
    {
      "name": "HTTP 500: the whole batch is re-sent",
      "expect": {
        "retryText.#json": {
          "events": [
            {
              "metricName": "api_calls",
              "idempotencyKey": "k1",
              "quantity": 1
            },
            {
              "metricName": "mcp_server.tool_invocations",
              "idempotencyKey": "k2",
              "quantity": 1
            },
            {
              "metricName": "tokens",
              "idempotencyKey": "k3",
              "quantity": 5
            }
          ]
        },
        "retryReason": "the ingestor answered HTTP 500",
        "refusedLog": null
      },
      "vars": {
        "aforoIngestResponse": {
          "status": 500,
          "text": "busy"
        }
      }
    },
    {
      "name": "HTTP 503: the whole batch is re-sent",
      "expect": {
        "retryText.#json": {
          "events": [
            {
              "metricName": "api_calls",
              "idempotencyKey": "k1",
              "quantity": 1
            },
            {
              "metricName": "mcp_server.tool_invocations",
              "idempotencyKey": "k2",
              "quantity": 1
            },
            {
              "metricName": "tokens",
              "idempotencyKey": "k3",
              "quantity": 5
            }
          ]
        },
        "retryReason": "the ingestor answered HTTP 503",
        "refusedLog": null
      },
      "vars": {
        "aforoIngestResponse": {
          "status": 503,
          "text": "busy"
        }
      }
    },
    {
      "name": "HTTP 408: the whole batch is re-sent",
      "expect": {
        "retryText.#json": {
          "events": [
            {
              "metricName": "api_calls",
              "idempotencyKey": "k1",
              "quantity": 1
            },
            {
              "metricName": "mcp_server.tool_invocations",
              "idempotencyKey": "k2",
              "quantity": 1
            },
            {
              "metricName": "tokens",
              "idempotencyKey": "k3",
              "quantity": 5
            }
          ]
        },
        "retryReason": "the ingestor answered HTTP 408",
        "refusedLog": null
      },
      "vars": {
        "aforoIngestResponse": {
          "status": 408,
          "text": "busy"
        }
      }
    },
    {
      "name": "HTTP 429: the whole batch is re-sent",
      "expect": {
        "retryText.#json": {
          "events": [
            {
              "metricName": "api_calls",
              "idempotencyKey": "k1",
              "quantity": 1
            },
            {
              "metricName": "mcp_server.tool_invocations",
              "idempotencyKey": "k2",
              "quantity": 1
            },
            {
              "metricName": "tokens",
              "idempotencyKey": "k3",
              "quantity": 5
            }
          ]
        },
        "retryReason": "the ingestor answered HTTP 429",
        "refusedLog": null
      },
      "vars": {
        "aforoIngestResponse": {
          "status": 429,
          "text": "busy"
        }
      }
    },
    {
      "name": "HTTP 401: the ingestor refused the batch, logged with the body, not re-sent",
      "expect": {
        "retryText": null,
        "refusedLog": "[aforo-metering] USAGE EVENT REFUSED (permanent, not retried): the ingestor refused the batch (HTTP 401; check aforo-api-key and aforo-endpoint): {\"error\":\"bad key\"}"
      },
      "vars": {
        "aforoIngestResponse": {
          "status": 401,
          "text": "{\"error\":\"bad key\"}"
        }
      }
    },
    {
      "name": "HTTP 400 with a long body: the body is cut to 300 characters",
      "expect": {
        "retryText": null
      },
      "vars": {
        "aforoIngestResponse": {
          "status": 400,
          "text": ""
        }
      }
    },
    {
      "name": "HTTP 301 (wrong URL): refused, not re-sent",
      "expect": {
        "retryText": null,
        "refusedLog": "[aforo-metering] USAGE EVENT REFUSED (permanent, not retried): the ingestor refused the batch (HTTP 301; check aforo-api-key and aforo-endpoint): "
      },
      "vars": {
        "aforoIngestResponse": {
          "status": 301,
          "text": ""
        }
      }
    },
    {
      "name": "a 202 whose body cannot be read counts as delivered",
      "expect": {
        "retryText": null,
        "refusedLog": null
      },
      "vars": {
        "aforoIngestResponse": {
          "status": 202,
          "text": "<html>"
        }
      }
    },
    {
      "name": "per-event retryable=true is re-sent whatever the message says",
      "expect": {
        "retryText.#json": {
          "events": [
            {
              "metricName": "tokens",
              "idempotencyKey": "k3",
              "quantity": 5
            }
          ]
        },
        "refusedLog": null,
        "retryDelayMs": 500
      },
      "vars": {
        "aforoIngestResponse": {
          "status": 202,
          "text": "{\"success\": true, \"data\": {\"accepted\": 2, \"failed\": 1, \"errors\": [{\"index\": 2, \"message\": \"Database busy\", \"retryable\": true}]}}"
        }
      }
    },
    {
      "name": "per-event retryable=false is permanent even with the transient text",
      "expect": {
        "retryText": null,
        "refusedLog": "[aforo-metering] USAGE EVENT REFUSED (permanent, not retried): tokens k3: The event could not be stored (invalid)"
      },
      "vars": {
        "aforoIngestResponse": {
          "status": 202,
          "text": "{\"success\": true, \"data\": {\"accepted\": 2, \"failed\": 1, \"errors\": [{\"index\": 2, \"message\": \"The event could not be stored (invalid)\", \"retryable\": false}]}}"
        }
      }
    },
    {
      "name": "backoff after attempt 1 is full jitter up to 1000 ms",
      "expect": {
        "retryDelayMs": 250
      },
      "vars": {
        "aforoIngestResponse": {
          "status": 500,
          "text": "oops"
        },
        "aforoJitter": 0.25,
        "aforoAttempt": 1
      }
    },
    {
      "name": "backoff after attempt 2 is full jitter up to 2000 ms",
      "expect": {
        "retryDelayMs": 1998
      },
      "vars": {
        "aforoIngestResponse": {
          "status": 503,
          "text": ""
        },
        "aforoJitter": 0.999,
        "aforoAttempt": 2
      }
    },
    {
      "name": "Retry-After in seconds wins over a smaller jittered delay",
      "expect": {
        "retryDelayMs": 3000
      },
      "vars": {
        "aforoIngestResponse": {
          "status": 429,
          "text": "",
          "retryAfter": "3"
        },
        "aforoJitter": 0.1
      }
    },
    {
      "name": "fractional Retry-After seconds",
      "expect": {
        "retryDelayMs": 1500
      },
      "vars": {
        "aforoIngestResponse": {
          "status": 429,
          "text": "",
          "retryAfter": "1.5"
        },
        "aforoJitter": 0.1
      }
    },
    {
      "name": "Retry-After as an HTTP-date",
      "expect": {
        "retryDelayMs": 7000
      },
      "vars": {
        "aforoIngestResponse": {
          "status": 503,
          "text": "",
          "retryAfter": "Tue, 28 Oct 2025 00:00:07 GMT"
        },
        "aforoJitter": 0.1
      }
    },
    {
      "name": "Retry-After in the past means 0: the jittered delay is used",
      "expect": {
        "retryDelayMs": 100
      },
      "vars": {
        "aforoIngestResponse": {
          "status": 503,
          "text": "",
          "retryAfter": "Mon, 27 Oct 2025 00:00:00 GMT"
        },
        "aforoJitter": 0.1
      }
    },
    {
      "name": "Retry-After is capped at 60 s",
      "expect": {
        "retryDelayMs": 60000
      },
      "vars": {
        "aforoIngestResponse": {
          "status": 429,
          "text": "",
          "retryAfter": "3600"
        },
        "aforoJitter": 0.1
      }
    },
    {
      "name": "an unreadable Retry-After is ignored",
      "expect": {
        "retryDelayMs": 100
      },
      "vars": {
        "aforoIngestResponse": {
          "status": 429,
          "text": "",
          "retryAfter": "soon"
        },
        "aforoJitter": 0.1
      }
    },
    {
      "name": "no answer (connection or timeout): the whole batch is re-sent, the reason is named",
      "expect": {
        "retryText.#json": {
          "events": [
            {
              "metricName": "api_calls",
              "idempotencyKey": "k1",
              "quantity": 1
            },
            {
              "metricName": "mcp_server.tool_invocations",
              "idempotencyKey": "k2",
              "quantity": 1
            },
            {
              "metricName": "tokens",
              "idempotencyKey": "k3",
              "quantity": 5
            }
          ]
        },
        "retryReason": "no answer from the ingestor (Remotely closed)"
      },
      "vars": {
        "aforoIngestResponse": {
          "status": 0,
          "text": "",
          "noAnswer": "Remotely closed"
        }
      }
    },
    {
      "name": "HTTP 501: every 5xx is retryable, the whole batch is re-sent",
      "expect": {
        "retryText.#json": {
          "events": [
            {
              "metricName": "api_calls",
              "idempotencyKey": "k1",
              "quantity": 1
            },
            {
              "metricName": "mcp_server.tool_invocations",
              "idempotencyKey": "k2",
              "quantity": 1
            },
            {
              "metricName": "tokens",
              "idempotencyKey": "k3",
              "quantity": 5
            }
          ]
        },
        "retryReason": "the ingestor answered HTTP 501",
        "refusedLog": null
      },
      "vars": {
        "aforoIngestResponse": {
          "status": 501,
          "text": "not implemented"
        }
      }
    },
    {
      "name": "HTTP 505: every 5xx is retryable, the whole batch is re-sent",
      "expect": {
        "retryText.#json": {
          "events": [
            {
              "metricName": "api_calls",
              "idempotencyKey": "k1",
              "quantity": 1
            },
            {
              "metricName": "mcp_server.tool_invocations",
              "idempotencyKey": "k2",
              "quantity": 1
            },
            {
              "metricName": "tokens",
              "idempotencyKey": "k3",
              "quantity": 5
            }
          ]
        },
        "retryReason": "the ingestor answered HTTP 505",
        "refusedLog": null
      },
      "vars": {
        "aforoIngestResponse": {
          "status": 505,
          "text": "http version not supported"
        }
      }
    },
    {
      "name": "nothing to re-send: no delay",
      "expect": {
        "retryDelayMs": 0
      },
      "vars": {
        "aforoIngestResponse": {
          "status": 202,
          "text": "{\"success\": true, \"data\": {\"accepted\": 3, \"failed\": 0, \"errors\": []}}"
        }
      }
    }
  ]
}
