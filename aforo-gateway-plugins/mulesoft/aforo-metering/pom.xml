<?xml version="1.0" encoding="UTF-8"?>
<!--
  Aforo Usage Metering - Mule 4 custom policy (API Manager, Mule runtime
  gateway: CloudHub, Runtime Fabric, hybrid). Layout follows MuleSoft's
  api-gateway-custom-policy-archetype.

  Build:    mvn clean package
            -> target/aforo-metering-3.0.2-mule-policy.jar
            Everything resolves from MuleSoft's public repository
            (repository.mulesoft.org) and Maven Central: no Anypoint or
            Nexus EE credentials. Dependency versions are pinned, so two
            builds hold the same files; the zip's entry timestamps differ
            (the mule-maven-plugin ignores project.build.outputTimestamp).
  Publish:  mvn clean deploy -Danypoint.org.id=<Anypoint organization id>
            (credentials: server id "exchange-server" in ~/.m2/settings.xml).
            Aforo's organization-service publishes the same jar and
            aforo-metering.yaml through the Exchange API instead.

  Exchange requires the groupId of a published asset to be the organization
  id, so groupId is a property. The default is a placeholder: a jar built
  without -Danypoint.org.id is fine for inspection and for publishing through
  the Exchange API (which takes the group from the URL), but `mvn deploy`
  needs the real id.
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>${anypoint.org.id}</groupId>
    <artifactId>aforo-metering</artifactId>
    <version>3.0.2</version>
    <!-- Same number as ../VERSION; tests/policy.test.cjs fails when they differ. -->

    <name>Aforo Usage Metering</name>
    <description>Checks the caller's Aforo API key, enforces Aforo quotas (429) and sends the call's usage to Aforo after the response.</description>

    <packaging>mule-policy</packaging>

    <properties>
        <anypoint.org.id>00000000-0000-0000-0000-000000000000</anypoint.org.id>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <mule.maven.plugin.version>4.10.1</mule.maven.plugin.version>
        <exchange.url>https://maven.anypoint.mulesoft.com/api/v3/organizations/${anypoint.org.id}/maven</exchange.url>
        <!-- Each supports Mule 4.1+ and Java 8, 11 and 17. -->
        <http.connector.version>1.10.3</http.connector.version>
        <objectstore.connector.version>1.2.2</objectstore.connector.version>
        <!-- 1.2.13 is the newest Java module whose dependencies are all public:
             1.2.14+ depend on spring-core 5.3.39-spring-framework-5.3.45, a
             MuleSoft-patched build that only MuleSoft's EE repository serves. -->
        <java.module.version>1.2.13</java.module.version>
        <secure.properties.module.version>1.2.7</secure.properties.module.version>
    </properties>

    <dependencies>
        <!-- Introspection, quota check and usage delivery. -->
        <dependency>
            <groupId>org.mule.connectors</groupId>
            <artifactId>mule-http-connector</artifactId>
            <version>${http.connector.version}</version>
            <classifier>mule-plugin</classifier>
        </dependency>
        <!-- Identity and quota caches, the delivery backlog. -->
        <dependency>
            <groupId>org.mule.connectors</groupId>
            <artifactId>mule-objectstore-connector</artifactId>
            <version>${objectstore.connector.version}</version>
            <classifier>mule-plugin</classifier>
        </dependency>
        <!-- Rebuilds the request attributes without the key header. -->
        <dependency>
            <groupId>org.mule.module</groupId>
            <artifactId>mule-java-module</artifactId>
            <version>${java.module.version}</version>
            <classifier>mule-plugin</classifier>
        </dependency>
        <!-- Lets the gateway hand the API key over encrypted when the
             runtime has gateway encryption turned on. -->
        <dependency>
            <groupId>com.mulesoft.modules</groupId>
            <artifactId>mule-secure-configuration-property-module</artifactId>
            <version>${secure.properties.module.version}</version>
            <classifier>mule-plugin</classifier>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.mule.tools.maven</groupId>
                <artifactId>mule-maven-plugin</artifactId>
                <version>${mule.maven.plugin.version}</version>
                <extensions>true</extensions>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-deploy-plugin</artifactId>
                <version>3.1.2</version>
                <executions>
                    <execution>
                        <id>upload-template</id>
                        <phase>deploy</phase>
                        <goals>
                            <goal>deploy-file</goal>
                        </goals>
                        <configuration>
                            <repositoryId>exchange-server</repositoryId>
                            <url>${exchange.url}</url>
                            <file>${project.basedir}/${project.artifactId}.yaml</file>
                            <generatePom>false</generatePom>
                            <groupId>${project.groupId}</groupId>
                            <artifactId>${project.artifactId}</artifactId>
                            <version>${project.version}</version>
                            <packaging>yaml</packaging>
                            <classifier>policy-definition</classifier>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

    <distributionManagement>
        <repository>
            <id>exchange-server</id>
            <name>Anypoint Exchange</name>
            <url>${exchange.url}</url>
            <layout>default</layout>
        </repository>
    </distributionManagement>

    <repositories>
        <repository>
            <id>mulesoft-releases</id>
            <name>MuleSoft public releases</name>
            <url>https://repository.mulesoft.org/releases/</url>
            <layout>default</layout>
        </repository>
    </repositories>

    <pluginRepositories>
        <pluginRepository>
            <id>mulesoft-plugin-releases</id>
            <name>MuleSoft public releases</name>
            <url>https://repository.mulesoft.org/releases/</url>
        </pluginRepository>
    </pluginRepositories>
</project>
