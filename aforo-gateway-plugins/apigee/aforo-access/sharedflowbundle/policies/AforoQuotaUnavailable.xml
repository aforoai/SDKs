<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<!-- Only with KVM quota_fail_open = "false": the quota check gave no answer,
     so the call is refused with 503 and Retry-After: 1 instead of served
     unchecked. Not metered. -->
<RaiseFault name="AforoQuotaUnavailable" continueOnError="false" enabled="true">
    <DisplayName>Aforo Access - Quota Check Unavailable (503)</DisplayName>
    <FaultResponse>
        <Set>
            <Headers>
                <Header name="Retry-After">1</Header>
            </Headers>
            <Payload contentType="application/json">{aforo.access.unavailableBody}</Payload>
            <StatusCode>503</StatusCode>
            <ReasonPhrase>Service Unavailable</ReasonPhrase>
        </Set>
    </FaultResponse>
    <IgnoreUnresolvedVariables>true</IgnoreUnresolvedVariables>
</RaiseFault>
