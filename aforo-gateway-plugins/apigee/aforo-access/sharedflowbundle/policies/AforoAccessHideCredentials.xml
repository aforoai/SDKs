<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<!-- Strips the end customer's API key from the request once
     AforoVerifyApiKey accepted it, so the customer's upstream never receives
     the end customer's Aforo key: the equivalent of Kong key-auth's
     hide_credentials = true. Removes every place AforoAccessPrepare reads a
     key from: headers x-api-key and apikey, query parameter apikey.
     continueOnError="true": a failure here must not fail the call. -->
<AssignMessage name="AforoAccessHideCredentials" continueOnError="true">
    <DisplayName>Aforo Access - Hide Credentials</DisplayName>
    <Remove>
        <Headers>
            <Header name="x-api-key"/>
            <Header name="apikey"/>
        </Headers>
        <QueryParams>
            <QueryParam name="apikey"/>
        </QueryParams>
    </Remove>
    <IgnoreUnresolvedVariables>true</IgnoreUnresolvedVariables>
    <AssignTo createNew="false" transport="http" type="request"/>
</AssignMessage>
