<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<!-- delivery_mode sync: sends the events and waits for the ingestor's answer
     (read by AforoMeteringCheckDelivery). The client waits too, so the wait is
     short: 1 s to connect, 2 s for the answer (Apigee takes only literal
     values here). 4xx counts as policy success, so the answer is kept and
     servicecallout.AforoMeteringSendEvent.failed means a transport error or a
     5xx. continueOnError="true": a failed send never fails the API call. -->
<ServiceCallout name="AforoMeteringSendEvent" continueOnError="true">
    <DisplayName>Aforo Metering - Send Events (wait for 202)</DisplayName>
    <Request variable="aforo.calloutRequest" clearPayload="true">
        <IgnoreUnresolvedVariables>true</IgnoreUnresolvedVariables>
        <Set>
            <Headers>
                <Header name="Content-Type">application/json</Header>
                <Header name="X-API-Key">{private.aforo.apiKey}</Header>
            </Headers>
            <Verb>POST</Verb>
            <Payload contentType="application/json">{aforo.eventPayload}</Payload>
        </Set>
    </Request>
    <Response>aforo.calloutResponse</Response>
    <Timeout>3000</Timeout>
    <HTTPTargetConnection>
        <Properties>
            <Property name="connect.timeout.millis">1000</Property>
            <Property name="io.timeout.millis">2000</Property>
            <Property name="success.codes">1xx,2xx,3xx,4xx</Property>
        </Properties>
        <URL>{private.aforo.endpoint}</URL>
    </HTTPTargetConnection>
</ServiceCallout>
