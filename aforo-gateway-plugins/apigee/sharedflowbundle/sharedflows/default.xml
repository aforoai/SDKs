<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<!--
  aforo-metering: attach to the environment's PostProxyFlowHook, with
  aforo-access on the PreProxyFlowHook. It bills only calls aforo-access let
  through on a managed proxy; on any other proxy no step runs.

  The PostProxyFlowHook runs right before the response goes to the client,
  so how the events are sent decides what the client waits for
  (KVM delivery_mode):

    async (default)  AforoMeteringSendAsync: a ServiceCallout with no
                     <Response>. Apigee does not wait for the answer and the
                     flow goes on at once, so the ingestor adds no latency.
                     The answer is never seen: an event the ingestor does not
                     store (outage, 5xx, a refused key, a per-event "could not
                     be stored") is lost, and nothing is logged.
    pubsub           AforoMeteringPublish: one Pub/Sub message per call to
                     KVM pubsub_topic; the Aforo Pub/Sub forwarder batches
                     the messages to the ingestor and acks after it accepted
                     them, so an ingestor outage loses nothing. The client
                     waits for the publish, not for the ingestor. Without
                     pubsub_topic the flow uses async instead.
    sync             AforoMeteringSendEvent waits for the 202 (1 s to
                     connect, 2 s for the answer), re-sends once what failed
                     transiently (whole batch on no answer / 5xx / 408; just
                     the events the 202 reports as "could not be stored"),
                     and logs what is lost. Adds the ingestor's response time
                     to every metered call, at most about 4 s.

  Every step has continueOnError="true": metering never fails the API call.

  Upstream 4xx/5xx: by default Apigee routes a target error to the error flow,
  which skips the PostProxyFlowHook, so those calls are not metered from the
  hook. See the user guide ("Metering upstream errors") for the FlowCallout to
  add to the proxy's DefaultFaultRule.
-->
<SharedFlow name="default">
    <Step>
        <Name>AforoMeteringBuildEvents</Name>
        <Condition>(private.aforo.managedProxy = "true") and (aforo.access.refused = "false")</Condition>
    </Step>
    <Step>
        <Name>AforoMeteringSendAsync</Name>
        <Condition>(aforo.meteringSend = "true") and (private.aforo.deliveryMode != "sync") and ((private.aforo.deliveryMode != "pubsub") or (private.aforo.pubsubTopic = null))</Condition>
    </Step>
    <Step>
        <Name>AforoMeteringPublish</Name>
        <Condition>(aforo.meteringSend = "true") and (private.aforo.deliveryMode = "pubsub") and (private.aforo.pubsubTopic != null)</Condition>
    </Step>
    <Step>
        <Name>AforoMeteringSendEvent</Name>
        <Condition>(aforo.meteringSend = "true") and (private.aforo.deliveryMode = "sync")</Condition>
    </Step>
    <Step>
        <Name>AforoMeteringCheckDelivery</Name>
        <Condition>(aforo.meteringSend = "true") and (private.aforo.deliveryMode = "sync")</Condition>
    </Step>
    <Step>
        <Name>AforoMeteringSendEventRetry1</Name>
        <Condition>(aforo.meteringSend = "true") and (private.aforo.deliveryMode = "sync") and (aforo.meteringRetry = "true")</Condition>
    </Step>
    <Step>
        <Name>AforoMeteringLogDeliveryFailure</Name>
        <Condition>(aforo.meteringSend = "true") and (private.aforo.deliveryMode = "sync") and (aforo.meteringFirstAttempt != "delivered")</Condition>
    </Step>
</SharedFlow>
