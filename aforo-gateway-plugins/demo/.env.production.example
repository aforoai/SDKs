# Demo against Aforo PRODUCTION. Copy to .env.production, then replace every
# YOUR_* placeholder with your own values -- the demo refuses to start while any
# placeholder is left in place, rather than failing later with a confusing 403.
#
#   cp .env.production.example .env.production
#   # edit .env.production
#   cp .env.production .env
#   node scripts/generate-keys-and-config.js
#   docker compose up --build

# ── Host ports ───────────────────────────────────────────────────────────────
# Keep FRONTEND_PORT at 3000: the budget panel calls the ingestor directly and
# the ingestor allow-lists origins. On another port, products still load but the
# budget panel 403s until you add the origin to its CORS_ALLOWED_ORIGINS.
KONG_PROXY_PORT=8000
KONG_ADMIN_PORT=8001
FRONTEND_PORT=3000

# ── Aforo production endpoints ───────────────────────────────────────────────
DEMO_AFORO_ENDPOINT=https://usage-ingestor.aforo.ai/v1/ingest/batch
DEMO_INGESTOR_URL=https://usage-ingestor.aforo.ai
DEMO_PRICING_URL=https://pricing.aforo.ai

# Browser-facing Kong URL. Must match KONG_PROXY_PORT above.
DEMO_KONG_URL=http://localhost:8000

# Your API, as reachable from inside the Kong container.
DEMO_UPSTREAM=http://suchith-backend:9000

# Redis for the JTI blocklist and revocation checks, as seen from inside the
# Kong container. Both checks fail open, so a wrong value here means revocation
# is silently NOT enforced rather than traffic breaking.
DEMO_REDIS_HOST=host.docker.internal
DEMO_REDIS_PORT=6379

# ── Your identity — replace all of these ─────────────────────────────────────
# See "Where to find these values" in README.md.
DEMO_TENANT_ID=YOUR_TENANT_ID
DEMO_CUSTOMER_ID=YOUR_CUSTOMER_ID
DEMO_TEAM_ID=YOUR_TEAM_ID
DEMO_KEY_ID=YOUR_API_KEY_ID
DEMO_SUBSCRIPTION_ID=YOUR_SUBSCRIPTION_ID
