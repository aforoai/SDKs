# Copy to .env. docker compose reads it automatically, and
# scripts/generate-keys-and-config.js reads the same file, so the page and the
# gateway can never disagree about which port Kong is on.

# Host ports. Change these if 8000/8001/3000 are taken.
KONG_PROXY_PORT=8000
KONG_ADMIN_PORT=8001

# Keep FRONTEND_PORT at 3000 if you can. The budget panel calls the ingestor
# directly, and the ingestor allow-lists origins -- :3000, :3001, :5174 and
# :5175 ship in its defaults. On any other port the products still load (those
# go through Kong, which allows all origins) but the budget panel gets a 403
# until you add the origin to the ingestor's CORS_ALLOWED_ORIGINS and restart it.
FRONTEND_PORT=3000

# Where Aforo's usage-ingestor is listening.
INGESTOR_PORT=8084

# Redis, as seen from INSIDE the Kong container -- used for the JTI blocklist
# and client-revocation checks. host.docker.internal reaches a Redis publishing
# 6379 on your host. If Redis shares a docker network with Kong, use its service
# name instead. Both checks fail open, so a wrong value here means revocation is
# silently not enforced rather than traffic breaking.
DEMO_REDIS_HOST=host.docker.internal
DEMO_REDIS_PORT=6379

# Must match a real API key row in pricing-service for attribution to work.
DEMO_TENANT_ID=test-tenant
DEMO_CUSTOMER_ID=test-customer
DEMO_TEAM_ID=team-001
DEMO_KEY_ID=b0fd7c72-9a29-465c-904d-1528ccd97f25
