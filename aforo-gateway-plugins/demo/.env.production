# Production Demo Configuration
# Copy this to .env before running the demo

# Host ports - using 8010/8011 to avoid conflict with existing Kong
KONG_PROXY_PORT=8010
KONG_ADMIN_PORT=8011
FRONTEND_PORT=3000

# Production Aforo Services
DEMO_AFORO_ENDPOINT=https://usage-ingestor.aforo.ai/v1/ingest/batch
DEMO_INGESTOR_URL=https://usage-ingestor.aforo.ai
DEMO_PRICING_URL=https://pricing.aforo.ai

# Kong URL (browser-facing)
DEMO_KONG_URL=http://localhost:8010

# Suchith backend (inside Docker network)
DEMO_UPSTREAM=http://suchith-backend:9000

# Redis - Production (adjust if you have production Redis URL)
DEMO_REDIS_HOST=host.docker.internal
DEMO_REDIS_PORT=6379

# Demo tenant data (matches what's in production)
DEMO_TENANT_ID=test-tenant
DEMO_CUSTOMER_ID=test-customer
DEMO_TEAM_ID=team-001
DEMO_KEY_ID=b0fd7c72-9a29-465c-904d-1528ccd97f25
DEMO_SUBSCRIPTION_ID=444fa303-ca2d-4fdd-9576-a120e1c6be72
