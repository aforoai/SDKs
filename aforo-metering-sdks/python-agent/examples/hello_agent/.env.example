# Copy to .env and fill in the values for your tenant.
# The Aforo tenant + product + API key. The tenant + product must be a
# provisioned AI_AGENT product; the API key is sent as the X-API-Key header.
AFORO_TENANT_ID=tenant_replace_me
AFORO_PRODUCT_ID=prod_replace_me
AFORO_API_KEY=sk_live_replace_me

# Base URL events are POSTed to (/v1/ingest/batch is appended).
#   - Production:  https://api.aforo.ai
#   - Local dev:   http://localhost:8084  (a usage-ingestor on your machine)
AFORO_INGEST_URL=https://api.aforo.ai

# Optional — agent identifier the SDK carries on every event.
# Defaults to "agent_hello_001" if unset.
AFORO_AGENT_ID=agent_hello_001

# Optional — customer id the events are billed against. Defaults to
# "cust_hello_001" if unset. The SDK falls back to agent_id if neither
# per-event customer_id nor default_customer_id is set — this example
# sets it explicitly for clarity.
AFORO_CUSTOMER_ID=cust_hello_001
