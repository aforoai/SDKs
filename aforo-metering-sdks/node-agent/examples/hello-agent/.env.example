# Copy to .env and fill in the values.
# Workspace API key (sent as X-API-Key).
AFORO_API_KEY=sk_live_replace_me

# The Aforo customer billed for the run (customer-service id). Required.
AFORO_CUSTOMER_ID=cust_replace_me

# Optional — AI_AGENT product id, sent as metadata.productId.
AFORO_PRODUCT_ID=prod_replace_me

# Ingest URL. A bare host gets /v1/ingest/batch added.
#   - Local dev:   http://localhost:8084
#   - Production:  https://api.aforo.ai
AFORO_INGEST_URL=http://localhost:8084

# Optional — agent identifier (<= 36 chars) on every event.
AFORO_AGENT_ID=agent_hello_001
