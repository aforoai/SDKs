# Copy to .env and fill in the values for your tenant.
# The Aforo tenant + product + API key. The tenant + product must be a
# provisioned AI_AGENT product; the API key must have "billing:write" scope.
AFORO_TENANT_ID=tenant_replace_me
AFORO_PRODUCT_ID=prod_replace_me
AFORO_API_KEY=sk_live_replace_me

# The Aforo customer billed for the run (required by /v1/ingest/events).
AFORO_CUSTOMER_ID=cust_replace_me

# Aforo ingest URL (host, or host + /v1/ingest). The example defaults to local dev:
#   - Local dev:   http://localhost:8084
#   - Production:  https://api.aforo.ai
AFORO_INGEST_URL=http://localhost:8084

# Optional — agent identifier the SDK carries on every event.
# Defaults to "agent_hello_001" if unset.
AFORO_AGENT_ID=agent_hello_001
